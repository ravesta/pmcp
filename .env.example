# Contoh konfigurasi PMCP. Salin ke .env (tidak di-commit). Rahasia tidak boleh ada di repository.
NODE_ENV=development
# Lingkungan penerapan: development | test | staging | production. Server build Next.js selalu NODE_ENV=production,
# jadi staging WAJIB mengisi APP_ENV=staging. Tanpa APP_ENV, build produksi dianggap produksi.
APP_ENV=development
DATABASE_URL=postgresql://pmcp_app:GANTI_DI_LINGKUNGAN@localhost:5432/pmcp
APP_ORIGIN=https://pmcp.contoh.local
TRUSTED_PROXY_COUNT=1
TZ=Asia/Jakarta
LOG_LEVEL=info
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_MINUTES=720
# Hanya non-produksi (ditolak bila APP_ENV=production): menetapkan "hari ini" untuk uji.
# CLOCK_OVERRIDE=2026-10-28
